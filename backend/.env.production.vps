# VPS/PM2 Production Environment
NODE_ENV=production
PORT=4000

# Database (localhost for PM2)
DB_HOST=localhost             # localhost for non-Docker ✅
DB_PORT=5432
DB_NAME=blockchain_explorer
DB_USER=explorer_user         # Different user for security
DB_PASSWORD=STRONG_PASSWORD
RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
CHAIN_ID=1
START_BLOCK=0
CORS_ORIGIN=https://yourdomain.com
LOG_LEVEL=info